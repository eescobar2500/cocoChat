# Plantilla de variables de entorno del frontend.
# Copiar a .env si necesitás cambiar algún valor:
#   cp .env.example .env
#
# ⚠️ Todo lo que empiece por VITE_ se incluye en el bundle y es PÚBLICO:
# cualquiera puede leerlo con las herramientas de desarrollo del navegador.
# NUNCA pongas acá la API key de OpenAI: esa vive solo en el backend.

# URL del backend. Por defecto: http://localhost:3001
VITE_API_URL=http://localhost:3001
