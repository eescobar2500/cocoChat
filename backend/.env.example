# Plantilla de variables de entorno.
# Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
#
# El archivo .env NUNCA se sube a git (está en .gitignore).

# ============================================
# OBLIGATORIAS
# ============================================

# API key de OpenAI. Se obtiene en https://platform.openai.com/api-keys
# Vive SOLO en el backend: el frontend nunca la conoce.
OPENAI_API_KEY=sk-proj-reemplazar-por-tu-key

# ID del agente creado en la plataforma de OpenAI.
# Sus instructions, modelo, knowledge y tools viven allí: el backend solo
# lo referencia, no los duplica. No es un secreto equivalente a la API key,
# pero se configura acá para poder cambiar de agente sin tocar código.
OPENAI_AGENT_ID=agent_reemplazar-por-el-id-de-tu-agente

# ============================================
# OPCIONALES (tienen valor por defecto en el código)
# ============================================

# Puerto del backend. Por defecto: 3001
PORT=3001

# Entorno. En "development" los errores propios incluyen stack trace
# (útil para depurar). Poné "production" al desplegar.
# NODE_ENV=development

# Llave para las rutas de mantenimiento de sesiones (/api/sessions).
# Sin ella esas rutas quedan deshabilitadas. Generá una con:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# NUNCA la conoce el frontend.
# ADMIN_TOKEN=

# Qué API usa el chat:
#   agents    = Agents API — el agente con su knowledge (por defecto)
#   responses = Responses API — respaldo para cuando la Agents API deja de
#               procesar turnos. Pierde el knowledge del agente (usa solo
#               las instructions de src/config/fallbackInstructions.txt) y
#               la memoria pasa al cliente, que reenvía `history`.
# CHAT_MODE=agents

# Modelo del modo de respaldo. En modo "agents" no se usa.
# OPENAI_FALLBACK_MODEL=gpt-5.4-mini
